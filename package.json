{
    "name": "@point-of-sale/receipt-printer-renderer",
    "version": "0.3.0",
    "description": "Render ESC/POS commands created by ReceiptPrinterEncoder to 1-bit images, for printers that only support graphics",
    "type": "module",
    "exports": {
        "types": "./dist/receipt-printer-renderer.d.ts",
        "browser": {
            "import": "./dist/receipt-printer-renderer.esm.js",
            "require": "./dist/receipt-printer-renderer.umd.js",
            "script": "./dist/receipt-printer-renderer.umd.js"
        },
        "import": "./dist/receipt-printer-renderer.mjs",
        "require": "./dist/receipt-printer-renderer.cjs"
    },
    "main": "dist/receipt-printer-renderer.cjs",
    "module": "dist/receipt-printer-renderer.mjs",
    "types": "dist/receipt-printer-renderer.d.ts",
    "scripts": {
        "build": "npm run generate && tsc && rollup -c && rm -rf dist/tmp",
        "contact-sheet": "node tools/contact-sheet.js",
        "generate": "node tools/generate.js",
        "lint": "eslint --fix src test tools",
        "mocha": "mocha test/",
        "test": "npm run lint && npm run mocha",
        "test:types": "tsc -p test/types/tsconfig.json",
        "test:umd": "node test/umd/check.js"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/NielsLeenheer/ReceiptPrinterRenderer.git"
    },
    "keywords": [
        "pos",
        "point-of-sale",
        "receipt",
        "printer",
        "renderer",
        "escpos",
        "esc-pos",
        "starprnt",
        "star-prnt",
        "starline",
        "raster",
        "graphics",
        "bitmap",
        "image",
        "thermal-printer",
        "tsp100",
        "cat-printer"
    ],
    "author": "Niels Leenheer",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/NielsLeenheer/ReceiptPrinterRenderer/issues"
    },
    "homepage": "https://github.com/NielsLeenheer/ReceiptPrinterRenderer#readme",
    "devDependencies": {
        "@point-of-sale/receipt-printer-encoder": "^3.0.0",
        "@point-of-sale/star-graphics-printer-encoder": "^1.0.0",
        "@rollup/plugin-commonjs": "^24.1.0",
        "@rollup/plugin-node-resolve": "^15.0.2",
        "@rollup/plugin-terser": "^0.4.1",
        "@zxing/library": "^0.21.3",
        "bwip-js": "^4.11.4",
        "chai": "^4.3.7",
        "eslint": "^8.39.0",
        "eslint-config-google": "^0.14.0",
        "javascript-stringify": "^2.1.0",
        "jsbarcode": "^3.12.3",
        "jsqr": "^1.4.0",
        "mocha": "^10.2.0",
        "opentype.js": "^2.0.0",
        "puppeteer-core": "25.10.0",
        "receiptio": "5.0.1",
        "receiptline": "4.0.4",
        "rollup": "^3.20.7",
        "rollup-plugin-dts": "^6.3.0",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@point-of-sale/codepage-encoder": "^3.0.0",
        "lean-qr": "^2.4.1"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ]
}
